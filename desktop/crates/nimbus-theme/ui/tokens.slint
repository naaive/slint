// SPDX-License-Identifier: MIT

// The Nimbus design tokens. Import them through "@nimbus/theme.slint".

export struct TextStyle {
    font-size: length,
    font-weight: int,
}

export struct Shadow {
    blur: length,
    offset-y: length,
    color: color,
}

export enum ButtonVariant {
    default,
    primary,
    flat,
    destructive,
}

export enum Tone {
    neutral,
    accent,
    success,
    warning,
    error,
}

export global Theme {
    // Inputs, set from Rust with `nimbus_theme::apply_theme!`.
    in-out property <bool> dark: true;
    in-out property <color> accent: #3584e4;
    in-out property <length> corner-radius: 12px;
    in-out property <string> font-family: "Inter";
    in-out property <length> font-size: 14px;
    in-out property <bool> animations: true;

    // Surfaces, from back to front.
    out property <color> background: dark ? #1c1c20 : #f4f4f6;
    out property <color> surface: dark ? #252529 : #ffffff;
    out property <color> surface-raised: dark ? #2f2f34 : #ffffff;
    out property <color> surface-sunken: dark ? #161619 : #e9e9ed;
    out property <color> surface-hover: dark ? #ffffff12 : #0000000c;
    out property <color> surface-pressed: dark ? #ffffff21 : #00000019;
    out property <color> surface-selected: accent.with-alpha(dark ? 0.24 : 0.16);
    out property <color> control: dark ? #ffffff17 : #0000000f;
    out property <color> control-hover: dark ? #ffffff24 : #0000001a;
    out property <color> control-pressed: dark ? #ffffff33 : #00000029;
    out property <color> overlay: dark ? #00000099 : #00000059;
    out property <color> panel-background: dark ? #121215d9 : #f8f8facc;
    out property <color> popup-background: dark ? #2a2a2ff2 : #fffffff2;

    // Content.
    out property <color> text: dark ? #f3f3f6 : #1c1c21;
    out property <color> text-secondary: dark ? #a9a9b4 : #5c5c68;
    out property <color> text-disabled: dark ? #66666f : #a6a6b0;
    out property <color> border: dark ? #ffffff17 : #00000017;
    out property <color> border-strong: dark ? #ffffff2e : #0000002e;
    out property <color> focus-ring: accent.with-alpha(0.6);

    // Accent and its states.
    out property <color> accent-hover: oklch(clamp(accent-lch.lightness + (dark ? 0.05 : -0.05), 0, 1), accent-lch.chroma, accent-lch.hue);
    out property <color> accent-pressed: oklch(clamp(accent-lch.lightness - 0.1, 0, 1), accent-lch.chroma, accent-lch.hue);
    // Accent for text and icons on `surface`, which needs more contrast than a filled accent.
    out property <color> accent-text: oklch(dark ? max(accent-lch.lightness, 0.75) : min(accent-lch.lightness, 0.5), accent-lch.chroma, accent-lch.hue);
    out property <color> on-accent: accent-lch.lightness > 0.75 ? #1c1c21 : #ffffff;

    // Status.
    out property <color> success: dark ? #4fd08a : #1d8a4e;
    out property <color> warning: dark ? #f5c04a : #b36b00;
    out property <color> error: dark ? #ff7a75 : #d22f39;
    // Text on a `success` or `warning` fill.
    out property <color> on-status: dark ? #1c1c21 : #ffffff;
    // Fills for destructive actions; `error` is for text and icons.
    out property <color> destructive: dark ? #d8363f : #d22f39;
    out property <color> destructive-hover: dark ? #e5474f : #bd2730;
    out property <color> destructive-pressed: dark ? #b92a32 : #a31f27;
    out property <color> on-destructive: #ffffff;

    // Spacing scale.
    out property <length> spacing-xxs: 2px;
    out property <length> spacing-xs: 4px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 12px;
    out property <length> spacing-lg: 16px;
    out property <length> spacing-xl: 24px;
    out property <length> spacing-xxl: 32px;

    // Radii.
    out property <length> radius-small: round(corner-radius / 2px) * 1px;
    out property <length> radius-medium: corner-radius * 0.75;
    out property <length> radius-large: corner-radius;
    out property <length> radius-xlarge: corner-radius * 1.5;
    out property <length> radius-pill: 999px;

    // Sizes.
    out property <length> control-height: 34px;
    out property <length> control-height-small: 28px;
    out property <length> row-height: 52px;
    out property <length> header-bar-height: 48px;
    out property <length> icon-size: 16px;
    out property <length> icon-size-large: 24px;
    out property <length> focus-ring-width: 2px;

    // Type scale, relative to `font-size`.
    out property <TextStyle> caption: { font-size: round(font-size * 0.857 / 1px) * 1px, font-weight: 400 };
    out property <TextStyle> body: { font-size: font-size, font-weight: 400 };
    out property <TextStyle> body-strong: { font-size: font-size, font-weight: 600 };
    out property <TextStyle> title: { font-size: round(font-size * 1.143 / 1px) * 1px, font-weight: 700 };
    out property <TextStyle> headline: { font-size: round(font-size * 1.571 / 1px) * 1px, font-weight: 700 };
    out property <TextStyle> display: { font-size: round(font-size * 2.571 / 1px) * 1px, font-weight: 300 };

    // Elevation.
    out property <Shadow> elevation-1: { blur: 4px, offset-y: 1px, color: dark ? #0000004d : #0000001f };
    out property <Shadow> elevation-2: { blur: 12px, offset-y: 4px, color: dark ? #00000066 : #00000024 };
    out property <Shadow> elevation-3: { blur: 28px, offset-y: 10px, color: dark ? #00000080 : #0000002e };

    // Motion durations, zero when `animations` is false. Easing curves are in `Motion`.
    out property <duration> duration-fast: animations ? 100ms : 0ms;
    out property <duration> duration-normal: animations ? 200ms : 0ms;
    out property <duration> duration-slow: animations ? 350ms : 0ms;

    private property <{lightness: float, chroma: float, hue: float, alpha: float}> accent-lch: accent.to-oklch();
}

// Easing curves for `Theme`'s durations.
// They're a separate global because Slint can't expose `easing` properties to Rust, and `Theme` is exported to Rust.
export global Motion {
    out property <easing> standard: cubic-bezier(0.2, 0, 0, 1);
    out property <easing> enter: cubic-bezier(0, 0, 0, 1);
    out property <easing> exit: cubic-bezier(0.3, 0, 1, 1);
}
