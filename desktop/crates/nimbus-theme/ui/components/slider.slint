// SPDX-License-Identifier: MIT

import { Theme, Motion } from "../tokens.slint";
import { Icon } from "icon.slint";
import { FocusRing } from "focus-ring.slint";

// A horizontal slider, optionally led by an icon, such as volume or brightness.
export component Slider {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    // The keyboard step; zero disables keyboard changes.
    in property <float> step: 1;
    in property <image> icon;
    in property <bool> enabled: true;
    in-out property <float> value: root.minimum;
    out property <bool> has-focus: focus-scope.has-focus;
    out property <bool> pressed: touch.pressed;

    // Emitted while the user changes the value.
    callback changed(value: float);
    // Emitted when the user finishes a change, for expensive updates.
    callback released(value: float);

    private property <bool> has-icon: root.icon.width > 0;
    private property <float> fraction: root.maximum > root.minimum
        ? clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0, 1) : 0;
    private property <length> handle-size: 20px;

    public function set-value(new-value: float) {
        if !root.enabled {
            return;
        }
        let clamped = clamp(new-value, root.minimum, max(root.minimum, root.maximum));
        if clamped != root.value {
            root.value = clamped;
            root.changed(clamped);
        }
    }

    min-height: max(28px, root.handle-size);
    min-width: 120px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: slider;
    accessible-value: round(root.value);
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-enabled: root.enabled;
    accessible-action-increment => {
        root.set-value(root.value + root.step);
        root.released(root.value);
    }
    accessible-action-decrement => {
        root.set-value(root.value - root.step);
        root.released(root.value);
    }
    forward-focus: focus-scope;

    HorizontalLayout {
        spacing: Theme.spacing-md;

        if root.has-icon: Icon {
            cross-axis-self-alignment: center;
            source: root.icon;
            color: Theme.text;
        }

        area := Rectangle {
            horizontal-stretch: 1;

            Rectangle {
                x: root.handle-size / 2;
                width: parent.width - root.handle-size;
                height: 4px;
                border-radius: 2px;
                background: Theme.control-hover;

                Rectangle {
                    x: 0;
                    width: parent.width * root.fraction;
                    border-radius: 2px;
                    background: touch.has-hover || touch.pressed ? Theme.accent-hover : Theme.accent;
                }
            }

            handle := Rectangle {
                width: root.handle-size;
                height: root.handle-size;
                x: (parent.width - self.width) * root.fraction;
                border-radius: self.height / 2;
                background: Theme.dark ? #f3f3f6 : #ffffff;
                border-width: Theme.dark ? 0 : 1px;
                border-color: Theme.border;
                drop-shadow-blur: 3px;
                drop-shadow-offset-y: 1px;
                drop-shadow-color: #00000050;

                if focus-scope.keyboard-focus: FocusRing {
                    radius: root.handle-size / 2;
                }
            }

            touch := TouchArea {
                enabled: root.enabled;
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        root.set-value(root.value-at(self.mouse-x));
                    } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                        root.released(root.value);
                    }
                }
                moved => {
                    if self.pressed {
                        root.set-value(root.value-at(self.mouse-x));
                    }
                }
                scroll-event(event) => {
                    if event.delta-y == 0 {
                        return reject;
                    }
                    let step = root.step > 0 ? root.step : (root.maximum - root.minimum) / 20;
                    root.set-value(root.value + (event.delta-y > 0 ? step : -step));
                    root.released(root.value);
                    accept
                }
            }
        }
    }

    pure function value-at(x: length) -> float {
        let track = area.width - root.handle-size;
        if track <= 0 {
            return root.minimum;
        }
        root.minimum + clamp((x - root.handle-size / 2) / track, 0, 1) * (root.maximum - root.minimum)
    }

    focus-scope := FocusScope {
        property <bool> keyboard-focus;

        x: 0;
        width: 0;
        enabled: root.enabled;
        focus-gained(reason) => {
            self.keyboard-focus = reason == FocusReason.tab-navigation;
        }
        focus-lost => {
            self.keyboard-focus = false;
        }
        key-pressed(event) => {
            if root.step <= 0 {
                return reject;
            }
            if event.text == Key.RightArrow || event.text == Key.UpArrow {
                root.set-value(root.value + root.step);
            } else if event.text == Key.LeftArrow || event.text == Key.DownArrow {
                root.set-value(root.value - root.step);
            } else if event.text == Key.Home {
                root.set-value(root.minimum);
            } else if event.text == Key.End {
                root.set-value(root.maximum);
            } else {
                return reject;
            }
            root.released(root.value);
            accept
        }
    }
}
