import { Theme } from "../tokens.slint";

// The keyboard focus indicator; place it as the last child of the focused control.
// It fills its parent and draws `offset` outside it.
export component FocusRing {
    in property <length> radius: Theme.radius-medium;
    in property <length> offset: 2px;

    accessible-role: none;

    Rectangle {
        x: -root.offset;
        y: -root.offset;
        width: root.width + 2 * root.offset;
        height: root.height + 2 * root.offset;
        border-radius: root.radius + root.offset;
        border-width: Theme.focus-ring-width;
        border-color: Theme.focus-ring;
    }
}
