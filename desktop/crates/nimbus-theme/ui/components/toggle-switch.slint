// SPDX-License-Identifier: MIT

import { Theme, Motion } from "../tokens.slint";
import { FocusRing } from "focus-ring.slint";

// An on/off switch for settings that apply immediately.
export component ToggleSwitch {
    in property <bool> enabled: true;
    in-out property <bool> checked;
    out property <bool> has-focus: focus-scope.has-focus;

    // Emitted after a user action changes `checked`.
    callback toggled(checked: bool);

    public function toggle() {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    width: 44px;
    height: 24px;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: switch;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.toggle();
    }
    forward-focus: focus-scope;

    track := Rectangle {
        border-radius: self.height / 2;
        background: root.checked
            ? (touch.has-hover ? Theme.accent-hover : Theme.accent)
            : (touch.has-hover ? Theme.control-pressed : Theme.control-hover);
        animate background { duration: Theme.duration-normal; easing: Motion.standard; }
    }

    thumb := Rectangle {
        width: root.height - 6px;
        height: self.width;
        x: root.checked ? root.width - self.width - 3px : 3px;
        y: 3px;
        border-radius: self.height / 2;
        background: root.checked ? Theme.on-accent : (Theme.dark ? #e6e6ea : #ffffff);
        drop-shadow-blur: 2px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000040;
        animate x { duration: Theme.duration-normal; easing: Motion.standard; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.toggle();
        }
    }

    focus-scope := FocusScope {
        property <bool> keyboard-focus;

        x: 0;
        width: 0;
        enabled: root.enabled;
        focus-on-click: false;
        focus-gained(reason) => {
            self.keyboard-focus = reason == FocusReason.tab-navigation;
        }
        focus-lost => {
            self.keyboard-focus = false;
        }
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.toggle();
                return accept;
            }
            reject
        }
    }

    if focus-scope.keyboard-focus: FocusRing {
        radius: root.height / 2;
    }
}
