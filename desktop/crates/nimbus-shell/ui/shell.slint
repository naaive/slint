// The Nimbus shell's windows, each shown on a surface of its own.
// Per output: the panel, the dock, a popup, the overlay with the launcher, overview, and power dialog, the toasts, the OSD, the window switcher,
// and on one output the polkit authentication dialog;
// and while locked, the lock screen.
// Rust sets what every window shows alike on the `Desktop` global, and what the parts of one output show on `ShellOutput`;
// see `src/model/mod.rs` and `src/view.rs`.
// Each `surface-*` property is the logical size its surface should have, 0 where the surface spans the output.

import { Theme, Motion, Icons, Icon, Divider } from "@nimbus/theme.slint";
import {
    RectData, AppVisual, WorkspaceItem, WindowItem, DockItem, DockMenuWindow, AppItem,
    NotificationItem, NotificationAction, CalendarDay, Popup, OsdKind, PowerAction,
    NetworkKind, SystemStatus, PanelSettings, AuthState, SwitcherItem,
} from "models.slint";
import { Desktop } from "desktop.slint";
import { ShellOutput } from "output.slint";
import { ShellPopup, MenuItem } from "common.slint";
import { PanelBar, DockBar } from "bars.slint";
import { DockMetrics } from "dock.slint";
import { Launcher } from "launcher.slint";
import { Overview } from "overview.slint";
import { QuickSettings } from "quick-settings.slint";
import { CalendarPopup } from "calendar.slint";
import { ToastStack } from "toasts.slint";
import { OsdPill } from "osd.slint";
import { SwitcherCard } from "switcher.slint";
import { LockScreen } from "lock-screen.slint";
import { PowerDialog } from "power-menu.slint";
import { AuthDialog } from "auth-dialog.slint";

export { Theme, Desktop, ShellOutput }
export {
    RectData, AppVisual, WorkspaceItem, WindowItem, DockItem, DockMenuWindow, AppItem,
    NotificationItem, NotificationAction, CalendarDay, Popup, OsdKind, PowerAction,
    NetworkKind, SystemStatus, PanelSettings, AuthState, SwitcherItem,
}

// The room around a floating part for its drop shadow.
global ShadowRoom {
    out property <length> size: Theme.elevation-3.blur + Theme.elevation-3.offset-y;
}

export component LockWindow inherits Window {
    in-out property <string> password;

    callback unlock-requested(password: string);

    public function focus-password() {
        lock.focus-password();
    }

    background: #101014;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;
    title: "Nimbus Lock Screen";

    lock := LockScreen {
        time: Desktop.long-time;
        date: Desktop.weekday + ", " + Desktop.date;
        user-name: Desktop.user-name;
        backdrop: Desktop.lock-backdrop;
        busy: Desktop.lock-busy;
        error: Desktop.lock-error;
        status: Desktop.status;
        password <=> root.password;
        unlock-requested(password) => {
            root.unlock-requested(password);
        }
    }
}

// The panel along the top or bottom edge, which slides away while a fullscreen window is focused.
export component PanelWindow inherits Window {
    out property <length> surface-height: Desktop.panel.height;
    out property <RectData> input-rect: root.shown ? { x: 0, y: 0, width: root.width, height: root.height } : { x: 0, y: 0, width: 0, height: 0 };

    private property <bool> shown: !ShellOutput.fullscreen-active;

    background: transparent;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;
    title: "Nimbus Panel";

    PanelBar {
        y: root.shown ? 0 : (Desktop.panel.top ? -root.height : root.height);
        width: root.width;
        height: root.height;
        animate y { duration: Theme.duration-normal; easing: Motion.standard; }
    }
}

// The dock, centered on the bottom edge, with room above it and at its sides for tooltips.
export component DockWindow inherits Window {
    out property <length> surface-width: bar.dock-width + 2 * root.side-room;
    out property <length> surface-height: DockMetrics.reserved + root.tooltip-room;
    // The space windows stay out of; an autohidden dock covers them instead.
    out property <length> exclusive-zone: Desktop.panel.dock-autohide ? 0 : DockMetrics.reserved;
    out property <RectData> input-rect: bar.input-rect;

    private property <length> side-room: 64px;
    private property <length> tooltip-room: 40px;

    background: transparent;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;
    title: "Nimbus Dock";

    bar := DockBar {
        width: root.width;
        height: root.height;
    }
}

// One popup of the panel or the dock, with room around it for its shadow.
export component PopupWindow inherits Window {
    in property <Popup> kind;
    in-out property <bool> power-menu-open;
    out property <length> surface-width: content.preferred-width + 2 * ShadowRoom.size;
    out property <length> surface-height: content.preferred-height + 2 * ShadowRoom.size;
    // The popup itself, without the room for its shadow.
    out property <RectData> geometry: { x: content.x, y: content.y, width: content.width, height: content.height };

    private property <bool> open;

    init => {
        root.open = true;
        keys.focus();
    }

    background: transparent;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;
    title: "Nimbus Popup";

    keys := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                ShellOutput.popup-requested(Popup.none, { x: 0, y: 0, width: 0, height: 0 });
                return accept;
            }
            reject
        }

        content := VerticalLayout {
            x: ShadowRoom.size;
            y: ShadowRoom.size;
            width: self.preferred-width;
            height: self.preferred-height;

            if root.kind == Popup.calendar: CalendarPopup {
                open: root.open;
                from-top: Desktop.panel.top;
                notifications: Desktop.notifications;
                days: Desktop.days;
                month-title: Desktop.month-title;
                weekday: Desktop.weekday;
                date: Desktop.date;
                do-not-disturb <=> Desktop.do-not-disturb;
                previous-month => {
                    ShellOutput.month-changed(-1);
                }
                next-month => {
                    ShellOutput.month-changed(1);
                }
                today-requested => {
                    ShellOutput.month-changed(0);
                }
                notification-activated(id) => {
                    ShellOutput.notification-activated(id);
                }
                notification-dismissed(id) => {
                    ShellOutput.notification-dismissed(id);
                }
                notification-action(id, key) => {
                    ShellOutput.notification-action(id, key);
                }
                clear-all => {
                    ShellOutput.clear-notifications();
                }
                do-not-disturb-toggled(on) => {
                    ShellOutput.do-not-disturb-toggled(on);
                }
            }

            if root.kind == Popup.quick-settings: QuickSettings {
                open: root.open;
                from-top: Desktop.panel.top;
                status: Desktop.status;
                dark-style: Theme.dark;
                do-not-disturb: Desktop.do-not-disturb;
                volume <=> Desktop.volume;
                brightness <=> Desktop.brightness;
                power-menu-open <=> root.power-menu-open;
                volume-changed(value) => {
                    ShellOutput.volume-changed(value);
                }
                mute-toggled => {
                    ShellOutput.mute-toggled();
                }
                brightness-changed(value) => {
                    ShellOutput.brightness-changed(value);
                }
                wifi-toggled => {
                    ShellOutput.wifi-toggled();
                }
                bluetooth-toggled => {
                    ShellOutput.bluetooth-toggled();
                }
                do-not-disturb-toggled => {
                    ShellOutput.do-not-disturb-toggled(!Desktop.do-not-disturb);
                }
                dark-style-toggled => {
                    ShellOutput.dark-style-toggled();
                }
                settings-requested(page) => {
                    ShellOutput.settings-requested(page);
                }
                media-previous => {
                    ShellOutput.media-previous();
                }
                media-play-pause => {
                    ShellOutput.media-play-pause();
                }
                media-next => {
                    ShellOutput.media-next();
                }
                lock-requested => {
                    ShellOutput.lock-requested();
                }
                suspend-requested => {
                    ShellOutput.suspend-requested();
                }
                power-requested(action) => {
                    ShellOutput.power-requested(action);
                }
            }

            if root.kind == Popup.dock-menu: ShellPopup {
                open: root.open;
                from-top: false;
                width: 260px;
                content-padding: Theme.spacing-xs;
                spacing: 0;

                Text {
                    height: Theme.control-height;
                    text: ShellOutput.dock-menu-title;
                    color: Theme.text-secondary;
                    font-family: Theme.font-family;
                    font-size: Theme.caption.font-size;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    x: Theme.spacing-md;
                }
                for w[row] in ShellOutput.dock-menu-windows: MenuItem {
                    icon: Icons.window;
                    text: w.title;
                    checked: w.focused;
                    clicked => {
                        ShellOutput.dock-menu-window(row);
                    }
                }
                if ShellOutput.dock-menu-windows.length > 0: Rectangle {
                    height: Theme.spacing-sm + 1px;

                    Divider {
                        width: parent.width - 2 * Theme.spacing-sm;
                    }
                }
                MenuItem {
                    icon: Icons.plus;
                    text: "New Window";
                    clicked => {
                        ShellOutput.dock-menu-new-window();
                    }
                }
                MenuItem {
                    icon: Icons.pin;
                    text: ShellOutput.dock-menu-favorite ? "Unpin from Dock" : "Pin to Dock";
                    clicked => {
                        ShellOutput.dock-menu-toggle-pin();
                    }
                }
                if ShellOutput.dock-menu-running: MenuItem {
                    icon: Icons.close;
                    text: ShellOutput.dock-menu-windows.length > 1 ? "Quit " + ShellOutput.dock-menu-windows.length + " Windows" : "Quit";
                    destructive: true;
                    clicked => {
                        ShellOutput.dock-menu-quit();
                    }
                }
            }
        }
    }
}

// The launcher, the overview, and the power dialog over the whole output, with the panel and dock above them.
export component OverlayWindow inherits Window {
    in-out property <string> launcher-query;
    in-out property <int> launcher-selected;

    // Focuses the launcher's search with the cursor at `offset` UTF-8 bytes.
    public function focus-launcher-at(offset: int) {
        launcher.place-cursor(offset);
    }

    public function focus-overview() {
        overview.focus-keys();
    }

    public function focus-power-dialog() {
        power-dialog.focus-keys();
    }

    private property <length> top-inset: Desktop.panel.top ? Desktop.panel.height : 0;
    private property <length> bottom-inset: Desktop.panel.top ? 0 : Desktop.panel.height;
    // Lets the launcher and overview fade in.
    private property <bool> opened;

    init => {
        root.opened = true;
    }

    background: transparent;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;
    title: "Nimbus Overlay";

    overview := Overview {
        open: root.opened && ShellOutput.overview-open;
        workspaces: ShellOutput.workspaces;
        windows: ShellOutput.windows;
        active-workspace: Desktop.active-workspace;
        active-count: ShellOutput.active-count;
        top-inset: root.top-inset;
        bottom-inset: root.bottom-inset + (Desktop.panel.show-dock ? DockMetrics.reserved : 0);
        window-activated(row) => {
            ShellOutput.window-activated(row);
        }
        window-closed(row) => {
            ShellOutput.window-closed(row);
        }
        window-moved(row, workspace) => {
            ShellOutput.window-moved(row, workspace);
        }
        workspace-clicked(index) => {
            ShellOutput.workspace-clicked(index);
        }
        search-clicked => {
            ShellOutput.launcher-requested(true);
        }
        close-requested => {
            ShellOutput.overview-requested(false);
        }
        key-typed(text) => {
            ShellOutput.overview-key-typed(text)
        }
    }

    launcher := Launcher {
        open: root.opened && ShellOutput.launcher-open;
        apps: ShellOutput.launcher-apps;
        query <=> root.launcher-query;
        selected <=> root.launcher-selected;
        top-inset: root.top-inset;
        bottom-inset: root.bottom-inset;
        query-edited(text) => {
            ShellOutput.launcher-query-edited(text);
        }
        activated(index) => {
            ShellOutput.launcher-activated(index);
        }
        close-requested => {
            ShellOutput.launcher-requested(false);
        }
    }

    DockBar {
        width: root.width;
        height: root.height - root.bottom-inset;
    }

    PanelBar {
        y: Desktop.panel.top ? 0 : root.height - Desktop.panel.height;
        width: root.width;
        height: Desktop.panel.height;
    }

    power-dialog := PowerDialog {
        action: Desktop.locked ? PowerAction.none : ShellOutput.power-action;
        confirmed(action) => {
            ShellOutput.power-confirmed(action);
        }
        cancelled => {
            ShellOutput.power-confirmed(PowerAction.none);
        }
    }
}

// The toasts in the top right corner.
export component ToastWindow inherits Window {
    out property <length> surface-width: ShadowRoom.size + stack.width + Theme.spacing-md;
    out property <length> surface-height: Theme.spacing-md + stack.preferred-height + ShadowRoom.size;
    out property <RectData> input-rect: { x: stack.x, y: stack.y, width: stack.width, height: stack.preferred-height };

    background: transparent;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;
    title: "Nimbus Notifications";

    stack := ToastStack {
        x: ShadowRoom.size;
        y: Theme.spacing-md;
        width: 380px;
        height: self.preferred-height;
        toasts: Desktop.toasts;
        activated(id) => {
            ShellOutput.notification-activated(id);
        }
        dismissed(id) => {
            ShellOutput.notification-dismissed(id);
        }
        action(id, key) => {
            ShellOutput.notification-action(id, key);
        }
    }
}

// The on-screen display above the bottom edge, which takes no input.
export component OsdWindow inherits Window {
    out property <length> surface-width: pill.width + 2 * ShadowRoom.size;
    out property <length> surface-height: pill.height + 2 * ShadowRoom.size;
    // The distance from the bottom of the space windows use, which keeps clear of the dock even while it hides.
    out property <length> edge-margin: 48px - ShadowRoom.size + (Desktop.panel.show-dock && Desktop.panel.dock-autohide ? DockMetrics.reserved : 0);
    // Whether the OSD shows, including while it fades out.
    out property <bool> showing: pill.visible;

    background: transparent;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;
    title: "Nimbus OSD";

    pill := OsdPill {
        x: ShadowRoom.size;
        y: ShadowRoom.size;
        shown: Desktop.osd-shown && !Desktop.locked;
        kind: Desktop.osd-kind;
        level: Desktop.osd-level;
        muted: Desktop.osd-muted;
    }
}

// The window switcher in the middle of the output, which takes no input.
export component SwitcherWindow inherits Window {
    out property <length> surface-width: card.width + 2 * ShadowRoom.size;
    out property <length> surface-height: card.height + 2 * ShadowRoom.size;

    background: transparent;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;
    title: "Nimbus Window Switcher";

    card := SwitcherCard {
        x: ShadowRoom.size;
        y: ShadowRoom.size;
        windows: ShellOutput.switcher-windows;
        title: ShellOutput.switcher-title;
    }
}

// The polkit authentication dialog over the whole output.
export component AuthWindow inherits Window {
    in-out property <string> response;

    public function focus-response() {
        dialog.focus-response();
    }

    background: transparent;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size;
    title: "Nimbus Authentication";

    dialog := AuthDialog {
        state: Desktop.auth;
        response <=> root.response;
        responded(response) => {
            ShellOutput.auth-responded(response);
        }
        cancelled => {
            ShellOutput.auth-cancelled();
        }
        identity-selected(index) => {
            ShellOutput.auth-identity-selected(index);
        }
    }
}
