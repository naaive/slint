import { Theme, Motion, Icons, Icon } from "@nimbus/theme.slint";
import { AppVisual, SystemStatus, NetworkKind } from "models.slint";

// Picks the symbolic icons that summarize the system state.
export global StatusIcons {
    public pure function network(s: SystemStatus) -> image {
        if s.network == NetworkKind.ethernet {
            return Icons.ethernet;
        }
        if s.network == NetworkKind.wifi {
            return s.wifi-strength > 0.75 ? Icons.wifi-3 : s.wifi-strength > 0.5 ? Icons.wifi-2 : s.wifi-strength > 0.25 ? Icons.wifi-1 : Icons.wifi-0;
        }
        s.wifi-enabled ? Icons.wifi-0 : Icons.wifi-off
    }

    public pure function volume(level: float, muted: bool) -> image {
        if muted || level <= 0 {
            return Icons.volume-muted;
        }
        level < 0.34 ? Icons.volume-low : level < 0.67 ? Icons.volume-medium : Icons.volume-high
    }

    public pure function battery(s: SystemStatus) -> image {
        if s.charging {
            return Icons.battery-charging;
        }
        s.battery-level > 0.85 ? Icons.battery-4 : s.battery-level > 0.6 ? Icons.battery-3 : s.battery-level > 0.35 ? Icons.battery-2 : s.battery-level > 0.12 ? Icons.battery-1 : Icons.battery-0
    }
}

// An application icon, or a tinted tile with the application's initial when it has none.
export component AppIcon {
    in property <AppVisual> visual;
    in property <length> size: 48px;

    width: root.size;
    height: root.size;
    accessible-role: none;

    if root.visual.has-icon: Image {
        width: 100%;
        height: 100%;
        source: root.visual.icon;
        image-fit: contain;
    }
    if !root.visual.has-icon: Rectangle {
        width: 88%;
        height: 88%;
        border-radius: self.height * 0.26;
        background: @linear-gradient(160deg, root.visual.tint.brighter(0.3) 0%, root.visual.tint 100%);
        drop-shadow-blur: root.size / 16;
        drop-shadow-offset-y: root.size / 32;
        drop-shadow-color: #00000040;

        Text {
            text: root.visual.initial;
            color: #ffffff;
            font-family: Theme.font-family;
            font-size: root.size * 0.42;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// A rounded, flat hover target in the panel, holding icons or text.
export component PanelButton inherits Rectangle {
    in property <bool> active;
    in property <length> padding-x: Theme.spacing-md;
    out property <bool> has-hover: touch.has-hover;

    callback clicked;

    min-width: layout.min-width;
    preferred-width: layout.preferred-width;
    border-radius: Theme.radius-pill;
    background: root.active ? Theme.control-pressed : touch.pressed ? Theme.control-pressed : touch.has-hover ? Theme.control-hover : transparent;
    animate background { duration: Theme.duration-fast; easing: Motion.standard; }
    accessible-role: button;
    accessible-action-default => {
        root.clicked();
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    layout := HorizontalLayout {
        padding-left: root.padding-x;
        padding-right: root.padding-x;
        spacing: Theme.spacing-sm;
        alignment: center;

        @children
    }
}

// A floating surface for the shell's popups: translucent, rounded, with the strongest elevation.
// It fades and slides in from the panel edge when `open` changes.
export component ShellPopup inherits Rectangle {
    in property <bool> open;
    // Slides down from the top panel, or up from a bottom one.
    in property <bool> from-top: true;
    in property <length> content-padding: Theme.spacing-lg;
    in property <length> spacing: Theme.spacing-md;

    private property <float> progress: root.open ? 1 : 0;

    visible: root.open || self.progress > 0;
    opacity: root.progress;
    background: Theme.popup-background;
    border-radius: Theme.radius-xlarge * 1.5;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: Theme.elevation-3.blur;
    drop-shadow-offset-y: Theme.elevation-3.offset-y;
    drop-shadow-color: Theme.elevation-3.color;
    transform-scale: 0.97 + 0.03 * root.progress;
    transform-origin: { x: self.width / 2, y: root.from-top ? 0 : self.height };
    animate progress { duration: Theme.duration-normal; easing: root.open ? Motion.enter : Motion.exit; }

    // Swallows clicks so that they don't close the popup.
    TouchArea { }

    VerticalLayout {
        padding: root.content-padding;
        spacing: root.spacing;

        @children
    }
}

// A row in a popup menu.
export component MenuItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> destructive;
    in property <bool> checked;

    callback clicked;

    min-height: Theme.control-height + Theme.spacing-xs;
    border-radius: Theme.radius-medium;
    background: touch.pressed ? Theme.surface-pressed : touch.has-hover ? Theme.surface-hover : transparent;
    animate background { duration: Theme.duration-fast; easing: Motion.standard; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.spacing-md;
        padding-right: Theme.spacing-md;
        spacing: Theme.spacing-md;

        if root.icon.width > 0: Icon {
            cross-axis-self-alignment: center;
            source: root.icon;
            color: root.destructive ? Theme.error : Theme.text;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: root.destructive ? Theme.error : Theme.text;
            font-family: Theme.font-family;
            font-size: Theme.body.font-size;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.checked: Icon {
            cross-axis-self-alignment: center;
            source: Icons.check;
            color: Theme.accent-text;
        }
    }
}
