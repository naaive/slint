import { Theme, Icons, Label, Card, Button, Spinner } from "@nimbus/theme.slint";
import { DisplaysModel } from "../globals.slint";
import { PageScroll, Group, RowDivider, EmptyState, SwitchRow, ChoiceRow, SegmentRow } from "../widgets.slint";

// The enabled displays at their relative logical sizes and positions; drag one to move it.
component Arrangement inherits Rectangle {
    private property <length> area-height: 150px;
    private property <float> aspect: max(0.1, DisplaysModel.arrangement-aspect);
    private property <length> box-width: min(self.width - 2 * Theme.spacing-xl, root.area-height * root.aspect);
    private property <bool> movable: DisplaysModel.editable && DisplaysModel.items.length > 1;

    height: root.area-height + 2 * Theme.spacing-xl;
    accessible-role: image;
    accessible-label: "Display arrangement";

    area := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.box-width;
        height: root.box-width / root.aspect;

        for item[index] in DisplaysModel.items: display := Rectangle {
            in-out property <length> dx;
            in-out property <length> dy;
            private property <bool> dragging: touch.pressed && (self.dx != 0 || self.dy != 0);

            visible: item.enabled && item.frac-width > 0;
            x: item.frac-x * parent.width + self.dx;
            y: item.frac-y * parent.height + self.dy;
            width: item.frac-width * parent.width;
            height: item.frac-height * parent.height;
            border-radius: Theme.radius-medium;
            border-width: 2px;
            border-color: Theme.background;
            background: self.dragging ? Theme.accent : touch.has-hover && root.movable ? Theme.control-hover : Theme.control-pressed;

            touch := TouchArea {
                enabled: root.movable;
                mouse-cursor: self.enabled ? MouseCursor.move : MouseCursor.default;
                moved => {
                    display.dx += self.mouse-x - self.pressed-x;
                    display.dy += self.mouse-y - self.pressed-y;
                }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.up && (display.dx != 0 || display.dy != 0) {
                        DisplaysModel.moved(index, display.x / area.width, display.y / area.height);
                        display.dx = 0;
                        display.dy = 0;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: Theme.spacing-xxs;

                Label {
                    text: index + 1;
                    style: Theme.headline;
                    color: display.dragging ? Theme.on-accent : Theme.text;
                    horizontal-alignment: center;
                }

                Label {
                    text: item.title;
                    style: Theme.caption;
                    color: display.dragging ? Theme.on-accent : Theme.text-secondary;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

export component DisplaysPage inherits PageScroll {
    if DisplaysModel.state == 0: HorizontalLayout {
        alignment: center;
        spacing: Theme.spacing-sm;
        padding: Theme.spacing-xxl;

        Spinner {
            size: 20px;
        }

        Label {
            text: "Looking for displays…";
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
    }

    if DisplaysModel.state == 2: VerticalLayout {
        spacing: Theme.spacing-sm;

        EmptyState {
            icon: Icons.monitor;
            title: "Displays Aren't Available";
            description: DisplaysModel.message;
        }

        HorizontalLayout {
            alignment: center;

            Button {
                text: "Try Again";
                icon: Icons.refresh;
                clicked => {
                    DisplaysModel.refresh();
                }
            }
        }
    }

    if DisplaysModel.state == 1: Card {
        content-padding: 0;

        Arrangement { }
    }

    if DisplaysModel.state == 1: VerticalLayout {
        spacing: Theme.spacing-xl;

        for item[index] in DisplaysModel.items: Group {
            private property <bool> editable: DisplaysModel.editable && item.enabled && !DisplaysModel.applying;

            title: (index + 1) + "  " + item.title;
            description: item.connector;

            if DisplaysModel.editable && DisplaysModel.items.length > 1: SwitchRow {
                title: "Use this display";
                checked: item.enabled;
                enabled: !DisplaysModel.applying;
                toggled(checked) => {
                    DisplaysModel.set-enabled(index, checked);
                }
            }

            if DisplaysModel.editable && DisplaysModel.items.length > 1: RowDivider { }

            ChoiceRow {
                title: "Resolution";
                model: item.resolutions;
                current-index: item.resolution-index;
                enabled: editable;
                chosen(choice) => {
                    DisplaysModel.choose-resolution(index, choice);
                }
            }

            RowDivider { }

            ChoiceRow {
                title: "Refresh rate";
                model: item.refresh-rates;
                current-index: item.refresh-index;
                enabled: editable;
                chosen(choice) => {
                    DisplaysModel.choose-refresh(index, choice);
                }
            }

            RowDivider { }

            SegmentRow {
                title: "Scale";
                control-width: 340px;
                model: item.scales;
                current-index: item.scale-index;
                enabled: editable;
                chosen(choice) => {
                    DisplaysModel.choose-scale(index, choice);
                }
            }

            RowDivider { }

            SegmentRow {
                title: "Rotation";
                control-width: 300px;
                model: ["None", "90°", "180°", "270°"];
                current-index: item.rotation-index;
                enabled: editable;
                chosen(choice) => {
                    DisplaysModel.choose-rotation(index, choice);
                }
            }
        }
    }

    if DisplaysModel.state == 1 && DisplaysModel.editable: HorizontalLayout {
        alignment: end;
        spacing: Theme.spacing-sm;

        Button {
            text: "Reset";
            variant: flat;
            enabled: DisplaysModel.changed && !DisplaysModel.applying;
            clicked => {
                DisplaysModel.reset();
            }
        }

        Button {
            text: "Apply";
            variant: primary;
            enabled: DisplaysModel.changed && !DisplaysModel.applying;
            clicked => {
                DisplaysModel.apply();
            }
        }
    }

    if DisplaysModel.state == 1: Label {
        text: DisplaysModel.editable ? "Drag displays to arrange them. Nimbus remembers the settings of each display." : DisplaysModel.message != "" ? DisplaysModel.message : "Displays are reported by the Nimbus compositor.";
        style: Theme.caption;
        color: Theme.text-secondary;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}
