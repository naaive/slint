// SPDX-License-Identifier: MIT

// The data shared between Rust and the pages. Rust fills the `in` properties and handles the callbacks;
// widgets bind two-way to the `in-out` ones so changes from either side stay visible.

export struct AccentSwatch {
    name: string,
    hex: string,
    color: color,
}

export struct WallpaperItem {
    path: string,
    name: string,
    thumbnail: image,
}

export struct SearchHit {
    page: int,
    title: string,
    page-title: string,
}

export struct PickerItem {
    id: string,
    title: string,
    subtitle: string,
}

export struct InputSource {
    title: string,
    subtitle: string,
    can-choose-variant: bool,
}

export struct ShortcutItem {
    chord: string,
    keys: [string],
    description: string,
    conflict: bool,
    invalid: bool,
}

export struct ShortcutCategory {
    title: string,
    items: [ShortcutItem],
}

export struct DisplayItem {
    title: string,
    connector: string,
    enabled: bool,
    resolutions: [string],
    resolution-index: int,
    refresh-rates: [string],
    refresh-index: int,
    scales: [string],
    scale-index: int,
    // Quarter turns clockwise.
    rotation-index: int,
    // The display's rectangle in the arrangement preview, as fractions of the whole arrangement; empty while it's off.
    frac-x: float,
    frac-y: float,
    frac-width: float,
    frac-height: float,
}

export struct InfoRow {
    label: string,
    value: string,
}

export struct OptionGroup {
    title: string,
    choices: [string],
    current: int,
}

export struct WifiNetworkItem {
    name: string,
    status: string,
    // Signal bars, from 0 to 3.
    bars: int,
    secured: bool,
    active: bool,
    known: bool,
}

export struct WiredItem {
    title: string,
    status: string,
    connected: bool,
    details: [InfoRow],
}

export struct BluetoothDeviceItem {
    name: string,
    status: string,
    // 0: other, 1: audio, 2: keyboard, 3: mouse, 4: computer.
    kind: int,
    paired: bool,
    connected: bool,
    busy: bool,
}

export struct SoundDeviceItem {
    name: string,
    // In percent, from 0 to 150.
    volume: float,
    muted: bool,
    // The bars of the volume icon, from 0 to 3.
    level: int,
}

export struct DefaultAppItem {
    title: string,
    choices: [string],
    current: int,
    // Whether any application of this kind is installed.
    available: bool,
}

// Navigation, search, and the status banner.
export global Nav {
    in-out property <int> page;
    in-out property <string> search;
    in property <[SearchHit]> search-results;
    // A message shown above the page, such as a failed save.
    in property <string> banner;
    in property <bool> banner-is-error;

    callback search-edited(text: string);
    callback dismiss-banner();
    callback quit();
    // The window shows another page.
    callback page-shown(page: int);
}

// The values of every setting, in the shape the widgets need.
export global Prefs {
    in-out property <int> color-scheme: 2;
    in property <[AccentSwatch]> accents;
    in-out property <string> accent: "#3584e4";
    in property <bool> accent-is-custom;
    in property <[WallpaperItem]> wallpapers;
    in property <bool> wallpapers-loading: true;
    in-out property <string> wallpaper;
    in-out property <string> font-family: "Inter";
    in-out property <float> font-size: 11;
    in-out property <int> scale-index;
    in-out property <bool> animations: true;
    in-out property <float> corner-radius: 12;

    in-out property <int> panel-position;
    in-out property <float> panel-height: 32;
    in-out property <bool> show-dock: true;
    in-out property <bool> dock-autohide;
    in property <[string]> clock-presets;
    in-out property <int> clock-preset-index;
    in-out property <string> clock-format;
    in property <string> clock-preview;
    in property <bool> clock-valid: true;
    in-out property <bool> clock-24-hour: true;
    in-out property <bool> battery-percentage: true;

    in-out property <int> workspace-count: 4;
    in-out property <int> window-layout;
    in-out property <float> gaps: 8;
    in-out property <bool> focus-follows-mouse;

    in property <[InputSource]> input-sources;
    in property <bool> can-add-source: true;
    in property <[OptionGroup]> option-groups;
    in-out property <string> keyboard-options;
    in-out property <float> repeat-delay: 300;
    in-out property <float> repeat-rate: 30;
    in-out property <bool> natural-scroll: true;
    in-out property <bool> tap-to-click: true;
    in-out property <float> pointer-speed;

    in property <[string]> lock-choices;
    in-out property <int> lock-index;
    in property <[string]> blank-choices;
    in-out property <int> blank-index;

    // Generic edits, keyed by setting name such as "panel.height".
    callback set-bool(key: string, value: bool);
    callback set-int(key: string, value: int);
    callback set-float(key: string, value: float);
    callback set-text(key: string, value: string);
    pure callback is-color(text: string) -> bool;

    callback choose-clock-preset(index: int);
    callback set-clock-24-hour(on: bool);
    callback choose-timeout(key: string, index: int);
    callback choose-option(group: int, index: int);
    callback pick-font();
    callback add-source();
    callback remove-source(index: int);
    callback move-source-up(index: int);
    callback pick-variant(index: int);
}

// A searchable list dialog, shared by the font, layout, and variant choosers.
export global Picker {
    in property <bool> open;
    in property <string> title;
    in property <string> placeholder: "Search";
    in property <[PickerItem]> items;
    in property <string> current;
    // The position of `current` in `items`, or -1.
    in property <int> current-index: -1;
    in-out property <string> query;

    callback query-edited(text: string);
    callback chosen(id: string);
    callback close();
}

export global ShortcutsModel {
    in property <[ShortcutCategory]> categories;
    in property <int> conflict-count;
    in property <[string]> action-kinds;
    in-out property <string> filter;

    callback filter-edited(text: string);
    callback edit(chord: string);
    callback add();
    callback remove(chord: string);
    callback reset();

    // The dialog that captures a key chord.
    in property <bool> capture-open;
    in property <bool> capture-adding;
    in property <string> capture-action;
    in-out property <int> capture-kind;
    // 0: none, 1: a command, 2: a workspace number.
    in property <int> capture-parameter;
    in-out property <string> capture-argument;
    in property <[string]> captured-keys;
    in property <string> capture-conflict;
    in property <bool> capture-can-apply;

    callback key-captured(text: string, control: bool, alt: bool, shift: bool, meta: bool);
    callback capture-kind-chosen(index: int);
    callback capture-argument-edited(text: string);
    callback capture-apply();
    callback capture-cancel();
}

export global DisplaysModel {
    // 0: loading, 1: ready, 2: unavailable.
    in property <int> state;
    // Why displays are unavailable, or why they can't be changed.
    in property <string> message;
    in property <[DisplayItem]> items;
    // The arrangement's width divided by its height.
    in property <float> arrangement-aspect: 1;
    // Whether the displays can be configured, rather than only listed.
    in property <bool> editable;
    // Whether the edits differ from the displays' current settings.
    in property <bool> changed;
    in property <bool> applying;
    // Seconds until applied settings revert unless they're kept; 0 when not asking.
    in property <int> confirm-seconds;

    callback refresh();
    callback set-enabled(index: int, enabled: bool);
    callback choose-resolution(index: int, choice: int);
    callback choose-refresh(index: int, choice: int);
    callback choose-scale(index: int, choice: int);
    callback choose-rotation(index: int, choice: int);
    // A display was dropped with its top-left corner at these fractions of the arrangement.
    callback moved(index: int, frac-x: float, frac-y: float);
    callback apply();
    callback reset();
    callback keep();
    callback revert();
}

export global AboutModel {
    in property <string> os-name: "Linux";
    in property <image> logo;
    in property <color> brand: #3584e4;
    in property <[InfoRow]> hardware;
    in property <[InfoRow]> software;
}

export global NetworkModel {
    // 0: loading, 1: ready, 2: NetworkManager isn't running.
    in property <int> state;
    in property <bool> has-wifi;
    in-out property <bool> wifi-enabled;
    // Off with a hardware switch, which the switch can't override.
    in property <bool> wifi-blocked;
    in property <string> wifi-status;
    in property <[WifiNetworkItem]> networks;
    // The name and details of the active Wi-Fi connection; empty without one.
    in property <string> connection-name;
    in property <[InfoRow]> connection-details;
    in property <[WiredItem]> wired;

    callback set-wifi-enabled(enabled: bool);
    callback scan();
    // Connects to the network at this index in `networks`, asking for a password when it needs one.
    callback activate(index: int);
    callback disconnect();
    callback forget(index: int);

    // The dialog asking for a Wi-Fi password.
    in property <bool> password-open;
    in property <string> password-network;
    // Why the password is asked for again, such as a wrong password.
    in property <string> password-error;
    in-out property <string> password;
    pure callback password-acceptable(text: string) -> bool;
    callback password-submit();
    callback password-cancel();
}

export global BluetoothModel {
    // 0: loading, 1: ready, 2: no adapter or BlueZ isn't running.
    in property <int> state;
    in property <string> adapter-name;
    in-out property <bool> powered;
    in-out property <bool> discoverable;
    in property <bool> discovering;
    in property <string> status;
    in property <[BluetoothDeviceItem]> devices;

    callback set-powered(on: bool);
    callback set-discoverable(on: bool);
    callback pair(index: int);
    callback connect(index: int);
    callback disconnect(index: int);
    callback remove(index: int);

    // The pairing dialog. Kinds: 0: confirm a code, 1: type a code on the device, 2: enter a passkey, 3: enter a PIN, 4: allow.
    in property <bool> pairing-open;
    in property <int> pairing-kind;
    in property <string> pairing-title;
    in property <string> pairing-message;
    in property <string> pairing-code;
    in-out property <string> pairing-input;
    pure callback pairing-input-valid(text: string) -> bool;
    callback pairing-accept();
    callback pairing-cancel();
}

export global SoundModel {
    // 0: loading, 1: ready, 2: no sound server.
    in property <int> state;
    in property <[SoundDeviceItem]> outputs;
    in property <[SoundDeviceItem]> inputs;
    // The names of `outputs` and `inputs`, and the default of each.
    in property <[string]> output-names;
    in-out property <int> output-index;
    in property <[string]> input-names;
    in-out property <int> input-index;

    callback choose-default(input: bool, index: int);
    // The volume in percent.
    callback set-volume(input: bool, index: int, volume: float);
    callback set-muted(input: bool, index: int, muted: bool);
}

export global TimeModel {
    // 0: loading, 1: ready, 2: timedated isn't available.
    in property <int> state;
    in property <string> now;
    in property <string> timezone;
    in property <string> timezone-city;
    in property <bool> can-pick-timezone;
    in property <bool> can-sync;
    in-out property <bool> sync;
    in property <string> sync-status;

    callback set-sync(on: bool);
    callback pick-timezone();
}

export global DefaultAppsModel {
    in property <bool> loading: true;
    in property <[DefaultAppItem]> items;

    callback chosen(category: int, index: int);
}
