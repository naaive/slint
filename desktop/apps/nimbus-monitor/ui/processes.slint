import { ListView } from "std-widgets.slint";
import { Theme, Label, Icon, Icons, Button, ButtonVariant, IconButton, SearchField, Dropdown } from "@nimbus/theme.slint";
import { ProcessRow, ProcessIcon } from "types.slint";

component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> descending;
    in property <TextHorizontalAlignment> alignment: left;
    callback clicked;

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }
    background: touch.has-hover ? Theme.surface-hover : transparent;
    border-radius: Theme.radius-small;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Theme.spacing-sm;
        padding-right: Theme.spacing-sm;
        spacing: Theme.spacing-xs;
        alignment: root.alignment == TextHorizontalAlignment.right ? end : start;

        Label {
            text: root.text;
            style: root.active ? Theme.body-strong : Theme.body;
            color: root.active ? Theme.text : Theme.text-secondary;
            vertical-alignment: center;
        }

        if root.active: Icon {
            source: root.descending ? Icons.chevron-down : Icons.chevron-up;
            color: Theme.text-secondary;
            size: 12px;
            y: (parent.height - self.height) / 2;
        }
    }
}

export component ProcessesPage inherits Rectangle {
    in property <[ProcessRow]> rows;
    in property <int> sort-column;
    in property <bool> sort-descending;
    in property <int> selected-pid: -1;
    in property <string> summary;
    in property <string> status;
    in-out property <string> query;
    in-out property <bool> tree;
    in-out property <int> scope;

    callback sort-requested(column: int);
    callback select(pid: int);
    callback activate(pid: int);
    callback end-selected();
    callback kill-selected();
    callback stop-selected();
    callback continue-selected();
    callback key-pressed(event: KeyEvent) -> bool;
    callback query-edited(text: string);
    callback tree-toggled(tree: bool);
    callback scope-selected(scope: int);

    public function focus-search() {
        search.focus();
    }

    property <length> user-width: 96px;
    property <length> cpu-width: 112px;
    property <length> memory-width: 92px;
    property <length> disk-width: 96px;
    property <length> pid-width: 68px;

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            root.key-pressed(event) ? EventResult.accept : EventResult.reject
        }

        VerticalLayout {
            padding: Theme.spacing-md;
            spacing: Theme.spacing-sm;

            HorizontalLayout {
                spacing: Theme.spacing-sm;
                search := SearchField {
                    horizontal-stretch: 1;
                    placeholder: "Search processes";
                    text <=> root.query;
                    edited(text) => {
                        root.query-edited(text);
                    }
                    accepted => {
                        keys.focus();
                    }
                }
                Dropdown {
                    width: 160px;
                    model: ["My Processes", "All Processes"];
                    current-index <=> root.scope;
                    selected(index) => {
                        root.scope-selected(index);
                    }
                }
                IconButton {
                    icon: Icons.list-view;
                    checked: root.tree;
                    accessible-label: "Show as tree";
                    clicked => {
                        root.tree = !root.tree;
                        root.tree-toggled(root.tree);
                    }
                }
            }

            HorizontalLayout {
                height: 32px;
                padding-left: Theme.spacing-sm;
                HeaderCell {
                    text: "Name";
                    horizontal-stretch: 1;
                    active: root.sort-column == 0;
                    descending: root.sort-descending;
                    clicked => { root.sort-requested(0); }
                }
                HeaderCell {
                    width: root.user-width;
                    text: "User";
                    active: root.sort-column == 1;
                    descending: root.sort-descending;
                    clicked => { root.sort-requested(1); }
                }
                HeaderCell {
                    width: root.cpu-width;
                    text: "CPU";
                    alignment: right;
                    active: root.sort-column == 2;
                    descending: root.sort-descending;
                    clicked => { root.sort-requested(2); }
                }
                HeaderCell {
                    width: root.memory-width;
                    text: "Memory";
                    alignment: right;
                    active: root.sort-column == 3;
                    descending: root.sort-descending;
                    clicked => { root.sort-requested(3); }
                }
                HeaderCell {
                    width: root.disk-width;
                    text: "Disk";
                    alignment: right;
                    active: root.sort-column == 4;
                    descending: root.sort-descending;
                    clicked => { root.sort-requested(4); }
                }
                HeaderCell {
                    width: root.pid-width;
                    text: "PID";
                    alignment: right;
                    active: root.sort-column == 5;
                    descending: root.sort-descending;
                    clicked => { root.sort-requested(5); }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                background: Theme.surface;
                border-radius: Theme.radius-large;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;

                if root.rows.length == 0: Label {
                    text: "No processes match";
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                ListView {
                    for row[index] in root.rows: Rectangle {
                        height: 34px;
                        accessible-role: list-item;
                        accessible-label: row.name;
                        accessible-item-selected: row.pid == root.selected-pid;
                        accessible-action-default => {
                            root.select(row.pid);
                        }
                        background: row.pid == root.selected-pid ? Theme.surface-selected
                            : touch.has-hover ? Theme.surface-hover
                            : mod(index, 2) == 1 ? Theme.surface-sunken.with-alpha(0.35) : transparent;

                        touch := TouchArea {
                            clicked => {
                                root.select(row.pid);
                                keys.focus();
                            }
                            double-clicked => {
                                root.activate(row.pid);
                            }
                        }

                        HorizontalLayout {
                            padding-left: Theme.spacing-md;
                            spacing: 0;

                            HorizontalLayout {
                                horizontal-stretch: 1;
                                padding-left: row.depth * 18px;
                                spacing: Theme.spacing-sm;
                                Icon {
                                    y: (parent.height - self.height) / 2;
                                    source: row.icon == ProcessIcon.terminal ? Icons.terminal
                                        : row.icon == ProcessIcon.kernel ? Icons.cpu
                                        : row.icon == ProcessIcon.service ? Icons.settings
                                        : Icons.application;
                                    color: row.icon == ProcessIcon.application ? Theme.accent-text : Theme.text-secondary;
                                }
                                Label {
                                    text: row.name;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                if row.state == "Stopped" || row.state == "Zombie": Label {
                                    text: row.state;
                                    style: Theme.caption;
                                    color: Theme.warning;
                                    vertical-alignment: center;
                                }
                            }
                            Label {
                                width: root.user-width;
                                text: row.user;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Rectangle {
                                width: root.cpu-width;
                                Rectangle {
                                    x: parent.width - Theme.spacing-sm - 40px;
                                    y: parent.height - 7px;
                                    width: 40px;
                                    height: 3px;
                                    border-radius: 1.5px;
                                    background: Theme.control;
                                    Rectangle {
                                        x: 0;
                                        width: parent.width * clamp(row.cpu-fraction, 0, 1);
                                        border-radius: 1.5px;
                                        background: row.cpu-fraction > 0.5 ? Theme.warning : Theme.accent;
                                    }
                                }
                                Label {
                                    x: 0;
                                    width: parent.width - Theme.spacing-sm;
                                    text: row.cpu;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                            Label {
                                width: root.memory-width;
                                text: row.memory;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            Label {
                                width: root.disk-width;
                                text: row.disk;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                color: row.disk == "–" ? Theme.text-disabled : Theme.text;
                            }
                            Label {
                                width: root.pid-width + Theme.spacing-md;
                                text: row.pid;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                color: Theme.text-secondary;
                            }
                            Rectangle { width: Theme.spacing-md; }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.spacing-sm;
                height: Theme.control-height;

                Label {
                    text: root.status != "" ? root.status : root.summary;
                    color: root.status != "" ? Theme.error : Theme.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Stop";
                    enabled: root.selected-pid >= 0;
                    clicked => { root.stop-selected(); }
                }
                Button {
                    text: "Continue";
                    enabled: root.selected-pid >= 0;
                    clicked => { root.continue-selected(); }
                }
                Button {
                    text: "Kill";
                    enabled: root.selected-pid >= 0;
                    clicked => { root.kill-selected(); }
                }
                Button {
                    text: "End Process";
                    variant: ButtonVariant.destructive;
                    enabled: root.selected-pid >= 0;
                    clicked => { root.end-selected(); }
                }
            }
        }
    }
}
